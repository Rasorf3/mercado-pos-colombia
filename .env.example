# Configuración únicamente local. No colocar secretos en este archivo.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# SQLite está en userData de cada POS, no se comparte por carpetas de red.
# Sin DATABASE_URL la API solo ofrece /health y no requiere PostgreSQL.
# Para habilitar sincronización, completar PRIVADAMENTE en .env (ignorado por Git).
DATABASE_URL=
# Clave aleatoria de vinculación: 32-256 caracteres, no una contraseña de usuario.
SYNC_PAIRING_KEY=

# La integración productiva con DIAN aún no está implementada.
# DIAN_API_URL=
# DIAN_CLIENT_ID=
# DIAN_CLIENT_SECRET=
